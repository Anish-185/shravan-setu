# Copy to server/.env and fill in. Never commit .env.
# Generate a key: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
# Comma-separated. Add the laptop's LAN IP so phones on the same Wi-Fi can reach it.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
